{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NecronPrismConfig",
  "description": "Combined config for necron-prism (prism core + logging + api).\n\nThe `prism` field is flattened so TOML keys `[network]`, `[network.socket]`,\n`[network.relay]`, `[network.buffer]`, `[motd]`, `[logging]` map directly to\nthe inner `Config`. `[api]` is a top-level section.",
  "type": "object",
  "properties": {
    "api": {
      "$ref": "#/$defs/ApiConfig"
    },
    "prism": {
      "$ref": "#/$defs/Config"
    }
  },
  "required": [
    "prism",
    "api"
  ],
  "$defs": {
    "ApiConfig": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "bearer_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_node_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "mock_connection_id_prefix": {
          "type": "string",
          "default": "PRSM"
        },
        "mock_kick_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "mock_rewrite_addr": {
          "type": [
            "string",
            "null"
          ]
        },
        "mock_target_addr": {
          "type": "string",
          "default": "127.0.0.1:25565"
        },
        "mode": {
          "$ref": "#/$defs/ApiMode",
          "default": "mock"
        },
        "timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 5000,
          "minimum": 0
        },
        "traffic_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 5000,
          "minimum": 0
        }
      }
    },
    "ApiMode": {
      "type": "string",
      "enum": [
        "http",
        "mock"
      ]
    },
    "BufferConfig": {
      "type": "object",
      "properties": {
        "io_uring_buffer_size": {
          "type": "integer",
          "format": "uint",
          "default": 65536,
          "minimum": 0
        },
        "packet_read_buffer_size": {
          "type": "integer",
          "format": "uint",
          "default": 16384,
          "minimum": 0
        },
        "relay_buffer_size": {
          "type": "integer",
          "format": "uint",
          "default": 65536,
          "minimum": 0
        },
        "splice_pipe_chunk_size": {
          "type": "integer",
          "format": "uint",
          "default": 65536,
          "minimum": 0
        }
      }
    },
    "Config": {
      "type": "object",
      "properties": {
        "motd": {
          "$ref": "#/$defs/MotdConfig",
          "default": {
            "favicon": {
              "mode": "json"
            },
            "local_json": "{\"version\":{\"name\":\"\\u00a7bnecron-prism \\u00a77status\",\"protocol\":-1},\"players\":{\"max\":100,\"online\":{online_player},\"sample\":[{\"name\":\"\\u00a77mode \\u00a78> \\u00a7f{relay_mode}\",\"id\":\"00000000-0000-0000-0000-000000000001\"},{\"name\":\"\\u00a77ping \\u00a78> \\u00a7b{ping_mode}\",\"id\":\"00000000-0000-0000-0000-000000000002\"},{\"name\":\"\\u00a77target \\u00a78> \\u00a7f{motd_target_addr}\",\"id\":\"00000000-0000-0000-0000-000000000003\"}]},\"description\":{\"text\":\"\\u00a7bnecron-prism \\u00a78\\u00bb \\u00a7fclean minecraft relay\\n\\u00a77online \\u00a7f{online_player} \\u00a78| \\u00a77favicon \\u00a7f{favicon_mode} \\u00a78| \\u00a77ping \\u00a7b{ping_mode}\"}}",
            "mode": "local",
            "ping_mode": "local",
            "protocol": "client",
            "upstream_addr": "mc.hypixel.net:25565",
            "upstream_ping_timeout_ms": 1500
          }
        },
        "network": {
          "$ref": "#/$defs/NetworkConfig",
          "default": {
            "buffer": {
              "io_uring_buffer_size": 65536,
              "packet_read_buffer_size": 16384,
              "relay_buffer_size": 65536,
              "splice_pipe_chunk_size": 65536
            },
            "relay": {
              "mode": "async"
            },
            "socket": {
              "first_packet_timeout_ms": 5000,
              "ip_tos": 184,
              "keepalive_interval_secs": 5,
              "keepalive_retries": 3,
              "keepalive_secs": 30,
              "listen_addr": "0.0.0.0:25565",
              "listen_backlog": 1024,
              "multipath_tcp": true,
              "reuse_address": true,
              "reuse_port": true,
              "tcp_fastopen": true,
              "tcp_keepalive": true,
              "tcp_nodelay": true,
              "tcp_notsent_lowat": 16384,
              "tcp_quickack": true,
              "upstream_connect_timeout_ms": 5000
            }
          }
        }
      }
    },
    "MotdConfig": {
      "type": "object",
      "properties": {
        "favicon": {
          "$ref": "#/$defs/MotdFaviconConfig",
          "default": {
            "mode": "json"
          }
        },
        "local_json": {
          "type": "string",
          "default": "{\"version\":{\"name\":\"\\u00a7bnecron-prism \\u00a77status\",\"protocol\":-1},\"players\":{\"max\":100,\"online\":{online_player},\"sample\":[{\"name\":\"\\u00a77mode \\u00a78> \\u00a7f{relay_mode}\",\"id\":\"00000000-0000-0000-0000-000000000001\"},{\"name\":\"\\u00a77ping \\u00a78> \\u00a7b{ping_mode}\",\"id\":\"00000000-0000-0000-0000-000000000002\"},{\"name\":\"\\u00a77target \\u00a78> \\u00a7f{motd_target_addr}\",\"id\":\"00000000-0000-0000-0000-000000000003\"}]},\"description\":{\"text\":\"\\u00a7bnecron-prism \\u00a78\\u00bb \\u00a7fclean minecraft relay\\n\\u00a77online \\u00a7f{online_player} \\u00a78| \\u00a77favicon \\u00a7f{favicon_mode} \\u00a78| \\u00a77ping \\u00a7b{ping_mode}\"}}"
        },
        "mode": {
          "$ref": "#/$defs/MotdMode",
          "default": "local"
        },
        "ping_mode": {
          "$ref": "#/$defs/StatusPingMode",
          "default": "local"
        },
        "ping_target_addr": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/MotdProtocol",
          "default": "client"
        },
        "upstream_addr": {
          "type": "string",
          "default": "mc.hypixel.net:25565"
        },
        "upstream_ping_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 1500,
          "minimum": 0
        }
      }
    },
    "MotdFaviconConfig": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/MotdFaviconMode",
          "default": "json"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_addr": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MotdFaviconMode": {
      "type": "string",
      "enum": [
        "json",
        "path",
        "passthrough",
        "remove"
      ]
    },
    "MotdMode": {
      "type": "string",
      "enum": [
        "local",
        "upstream"
      ]
    },
    "MotdProtocol": {
      "type": "string",
      "enum": [
        "client",
        "negative_one"
      ]
    },
    "NetworkConfig": {
      "type": "object",
      "properties": {
        "buffer": {
          "$ref": "#/$defs/BufferConfig",
          "default": {
            "io_uring_buffer_size": 65536,
            "packet_read_buffer_size": 16384,
            "relay_buffer_size": 65536,
            "splice_pipe_chunk_size": 65536
          }
        },
        "relay": {
          "$ref": "#/$defs/RelayConfig",
          "default": {
            "mode": "async"
          }
        },
        "socket": {
          "$ref": "#/$defs/NetworkSocketConfig",
          "default": {
            "first_packet_timeout_ms": 5000,
            "ip_tos": 184,
            "keepalive_interval_secs": 5,
            "keepalive_retries": 3,
            "keepalive_secs": 30,
            "listen_addr": "0.0.0.0:25565",
            "listen_backlog": 1024,
            "multipath_tcp": true,
            "reuse_address": true,
            "reuse_port": true,
            "tcp_fastopen": true,
            "tcp_keepalive": true,
            "tcp_nodelay": true,
            "tcp_notsent_lowat": 16384,
            "tcp_quickack": true,
            "upstream_connect_timeout_ms": 5000
          }
        }
      }
    },
    "NetworkSocketConfig": {
      "type": "object",
      "properties": {
        "bind_interface": {
          "type": [
            "string",
            "null"
          ]
        },
        "congestion_control": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_packet_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 5000,
          "minimum": 0
        },
        "fwmark": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "ip_tos": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": 184,
          "maximum": 255,
          "minimum": 0
        },
        "keepalive_interval_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": 5,
          "minimum": 0
        },
        "keepalive_retries": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": 3,
          "minimum": 0
        },
        "keepalive_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "listen_addr": {
          "type": "string",
          "default": "0.0.0.0:25565"
        },
        "listen_backlog": {
          "type": "integer",
          "format": "uint32",
          "default": 1024,
          "minimum": 0
        },
        "multipath_tcp": {
          "type": "boolean",
          "default": true
        },
        "recv_buffer_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "reuse_address": {
          "type": "boolean",
          "default": true
        },
        "reuse_port": {
          "type": "boolean",
          "default": true
        },
        "send_buffer_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "so_busy_poll": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tcp_fastopen": {
          "type": "boolean",
          "default": true
        },
        "tcp_fastopen_queue": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tcp_keepalive": {
          "type": "boolean",
          "default": true
        },
        "tcp_nodelay": {
          "type": "boolean",
          "default": true
        },
        "tcp_notsent_lowat": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": 16384,
          "minimum": 0
        },
        "tcp_quickack": {
          "type": "boolean",
          "default": true
        },
        "upstream_connect_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 5000,
          "minimum": 0
        }
      }
    },
    "RelayConfig": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/RelayMode",
          "default": "async"
        }
      }
    },
    "RelayMode": {
      "type": "string",
      "enum": [
        "async",
        "io_uring",
        "splice"
      ]
    },
    "StatusPingMode": {
      "type": "string",
      "enum": [
        "local",
        "zero_ms",
        "passthrough",
        "disconnect"
      ]
    }
  }
}
